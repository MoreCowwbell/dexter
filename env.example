# LLM API Keys
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key
GOOGLE_API_KEY=your-api-key
XAI_API_KEY=your-api-key
OPENROUTER_API_KEY=your-api-key

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Financial Data API Keys
# Priority order: Free providers first, then paid fallback
# 1. SEC EDGAR - Free (no key needed, just user agent)
# 2. yfinance - Free (requires Python + yfinance package)
# 3. Finnhub - Free tier (60 calls/min)
# 4. FinancialDatasets.ai - Paid ($200/mo) - used as fallback

# SEC EDGAR (free, official) - required by SEC for identification
SEC_USER_AGENT=YourApp/1.0 (your@email.com)

# Finnhub (free tier: 60 calls/minute) - https://finnhub.io/
FINNHUB_API_KEY=your-api-key

# FinancialDatasets.ai (paid, $200/mo) - used as last resort fallback
FINANCIAL_DATASETS_API_KEY=your-api-key

# Python path for yfinance provider (optional, defaults to 'python3')
# PYTHON_PATH=python3

# Web Search API Keys (Exa preferred, Tavily fallback)
EXASEARCH_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key

# LangSmith 
LANGSMITH_API_KEY=your-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=true
